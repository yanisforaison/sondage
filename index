<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Sight – Votre réponse</title>
<style>
  :root{--navy:#1E3989;--light:#EAF0FA;--line:#D9DEEA;--muted:#7F7F7F;--text:#262626}
  *{box-sizing:border-box}
  body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#F4F6FB;color:var(--text)}
  .card{max-width:520px;margin:8vh auto;background:#fff;border-radius:10px;padding:34px 30px;
        box-shadow:0 2px 14px rgba(30,57,137,.10);border-top:5px solid var(--navy)}
  @media (max-width:560px){.card{margin:0;border-radius:0;min-height:100vh;padding:28px 18px}}
  .brand{font-size:12px;letter-spacing:.12em;color:var(--navy);font-weight:bold;margin-bottom:18px}
  h1{color:var(--navy);font-size:22px;margin:0 0 18px}
  .opt{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:6px;
       padding:12px 14px;margin-bottom:8px;font-size:15px;color:#9AA3B5}
  .box{width:20px;height:20px;border:2px solid #C9D0DE;border-radius:50%;flex:none;
       display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff}
  .opt.on{border-color:var(--navy);background:var(--light);color:var(--navy);font-weight:bold}
  .opt.on .box{background:var(--navy);border-color:var(--navy)}
  p{line-height:1.55;font-size:15px;margin:18px 0 0}
  .sig{margin-top:28px;font-size:13px;color:var(--muted)}
  .err{color:#9C0006}
</style>
</head>
<body>
<div class="card">
  <div class="brand">SIGHT</div>
  <h1 id="titre">Merci pour votre retour</h1>
  <div id="opts"></div>
  <p id="texte"></p>
  <p class="sig">Yanis Foraison · Business Developer · Sight<br>+33 6 95 22 09 56</p>
</div>
<script>
  // Google Form qui enregistre les réponses (onglet Réponses du Form -> Google Sheet)
  const FORM = 'https://docs.google.com/forms/d/e/1FAIpQLSfTIHU25ccwf33WseP5b_ibwcmmdNrWUHwBHSsejsLPhH_WPQ/formResponse';
  const CHAMPS = { email: 'entry.1466868930', reponse: 'entry.1235213124', consultant: 'entry.1094664688', relance: 'entry.575036741' };

  const q = new URLSearchParams(location.search);
  const r = q.get('r') || '', k = q.get('k') || '', c = q.get('c') || '', s = q.get('s') || '';
  const LIB = {
    '1': 'Oui, organisons un échange' + (k ? ' avec ' + k : ''),
    '2': "Je n'ai pas de besoin pour l'instant",
    '3': 'Je ne recherche pas ce type de profil'
  };
  const TITRE = {'1': "Merci, c'est noté !", '2': 'Merci pour votre retour', '3': "Merci, c'est utile !"};
  const TEXTE = {
    '1': 'Je reviens vers vous très rapidement pour organiser un échange' + (k ? ' avec ' + k : '') + '.',
    '2': "Bien noté. Je me permettrai de reprendre de vos nouvelles dans quelques mois. Si un besoin apparaît d'ici là, une simple réponse à mon mail suffit.",
    '3': "Quel type de profil recherchez-vous plutôt ? Un simple mot en réponse à mon mail me permettra de vous proposer quelqu'un de plus adapté."
  };

  const opts = document.getElementById('opts');
  if (!LIB[r] || !c) {
    document.getElementById('titre').textContent = 'Lien incomplet';
    document.getElementById('texte').innerHTML = '<span class="err">Ce lien ne semble pas complet. Vous pouvez simplement répondre à mon mail.</span>';
  } else {
    opts.innerHTML = ['1', '2', '3'].map(x =>
      `<div class="opt${x === r ? ' on' : ''}"><span class="box">${x === r ? '✓' : ''}</span>${LIB[x]}</div>`).join('');
    document.getElementById('titre').textContent = TITRE[r];
    document.getElementById('texte').textContent = TEXTE[r];

    // Envoi de la réponse au Google Form (sans cookies : aucun compte Google nécessaire)
    const data = new URLSearchParams();
    data.append(CHAMPS.email, c);
    data.append(CHAMPS.reponse, r + ' – ' + LIB[r]);
    data.append(CHAMPS.consultant, k);
    data.append(CHAMPS.relance, s);
    const key = 'sight-vote-' + c + '-' + s;
    let deja = false;
    try { deja = sessionStorage.getItem(key) === r; } catch (e) {}
    if (!deja) {
      fetch(FORM, { method: 'POST', mode: 'no-cors', credentials: 'omit', body: data })
        .catch(() => { const i = new Image(); i.src = FORM + '?' + data.toString(); });
      try { sessionStorage.setItem(key, r); } catch (e) {}
    }
  }
</script>
</body>
</html>
